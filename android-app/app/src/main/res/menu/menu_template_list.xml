<?xml version="1.0" encoding="utf-8"?>
<!--
    Um único item que alterna entre a lista ativa e a arquivada. O título é definido em código
    (precisa da contagem), e o item é escondido quando não há nada arquivado - um item que abre uma
    lista vazia só ensina que não vale a pena tocar nele.

    SEM ícone de propósito: com ícone, ActionMenuItemView.shouldShowText() é falso em largura de
    telefone (config_allowActionMenuItemTextWithIcon = false), então "withText" é ignorado e sobra
    só o desenho - e a contagem, que é o motivo de o item existir, fica invisível. Medido.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/action_toggle_archived"
        android:title="@string/templates_active_menu"
        app:showAsAction="ifRoom|withText" />
</menu>
