<?xml version="1.0" encoding="utf-8"?>
<!--
    Single-activity navigation (ARCHITECTURE §5.4). Arguments are read through static helpers on
    each fragment (ADR-0018: no Safe Args plugin).
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="io.github.thiagojosetj.gym.ui.home.HomeFragment"
        android:label="@string/nav_home">
        <action
            android:id="@+id/action_home_to_editor"
            app:destination="@id/templateEditorFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_home_to_session"
            app:destination="@id/activeSessionFragment" />
    </fragment>

    <fragment
        android:id="@+id/templateListFragment"
        android:name="io.github.thiagojosetj.gym.ui.templates.TemplateListFragment"
        android:label="@string/nav_templates">
        <action
            android:id="@+id/action_templates_to_editor"
            app:destination="@id/templateEditorFragment" />
        <action
            android:id="@+id/action_templates_to_session"
            app:destination="@id/activeSessionFragment" />
    </fragment>

    <fragment
        android:id="@+id/exerciseLibraryFragment"
        android:name="io.github.thiagojosetj.gym.ui.library.ExerciseLibraryFragment"
        android:label="@string/nav_library">
        <argument
            android:name="selectMode"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_library_to_detail"
            app:destination="@id/exerciseDetailFragment" />
    </fragment>

    <!-- Same screen as the library tab, opened from the template editor to pick exercises. -->
    <fragment
        android:id="@+id/exercisePickerFragment"
        android:name="io.github.thiagojosetj.gym.ui.library.ExerciseLibraryFragment"
        android:label="@string/title_select_exercises">
        <argument
            android:name="selectMode"
            android:defaultValue="true"
            app:argType="boolean" />
        <action
            android:id="@+id/action_picker_to_detail"
            app:destination="@id/exerciseDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/exerciseDetailFragment"
        android:name="io.github.thiagojosetj.gym.ui.library.ExerciseDetailFragment"
        android:label="@string/title_exercise_detail">
        <argument
            android:name="exerciseId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/templateEditorFragment"
        android:name="io.github.thiagojosetj.gym.ui.templates.editor.TemplateEditorFragment"
        android:label="@string/title_template_edit">
        <argument
            android:name="templateId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_editor_to_picker"
            app:destination="@id/exercisePickerFragment" />
    </fragment>

    <!-- The workout in progress. Leaving it does not end it: the session lives in the database. -->
    <fragment
        android:id="@+id/activeSessionFragment"
        android:name="io.github.thiagojosetj.gym.ui.session.ActiveSessionFragment"
        android:label="@string/session_title">
        <argument
            android:name="sessionId"
            app:argType="string" />
    </fragment>

    <!--
        History. A finished session is read-only: this screen has no action that writes, and the
        detail is reached only from the list (SafeNavigation does nothing for an action that is not
        declared inside the current destination).
    -->
    <fragment
        android:id="@+id/historyListFragment"
        android:name="io.github.thiagojosetj.gym.ui.history.HistoryListFragment"
        android:label="@string/nav_history">
        <action
            android:id="@+id/action_history_to_detail"
            app:destination="@id/sessionDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/sessionDetailFragment"
        android:name="io.github.thiagojosetj.gym.ui.history.SessionDetailFragment"
        android:label="@string/history_detail_title">
        <argument
            android:name="sessionId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="io.github.thiagojosetj.gym.ui.settings.SettingsFragment"
        android:label="@string/title_settings" />
</navigation>
