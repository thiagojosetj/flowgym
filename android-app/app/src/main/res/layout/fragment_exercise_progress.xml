<?xml version="1.0" encoding="utf-8"?>
<!--
    One exercise across its history (PRODUCT_SPEC PRG-03).

    The records come first because they are what a person opens this screen for, and they are
    stat tiles rather than a chart: a single number is not a one-bar bar chart. Below them, the
    session-by-session list - which is also the table view of the chart that PRG-01 adds here.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="@dimen/screen_margin"
    android:paddingVertical="@dimen/space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/exercise_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            tools:text="Supino reto com barra" />

        <TextView
            android:id="@+id/span"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="12 sessões · de 2 de jun. de 2026 a 28 de set. de 2026" />

        <TextView
            android:id="@+id/failed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/exercise_progress_failed"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="gone" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Widget.Gym.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_progress_records_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/exercise_progress_records_scope"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/records_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/record_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m" />
            </com.google.android.material.card.MaterialCardView>

            <!--
                Said out loud rather than left to be inferred from three blank rows: an exercise
                with no load has no load records, and that is a fact about the exercise, not a
                failure to measure it.
            -->
            <TextView
                android:id="@+id/no_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exercise_progress_no_records"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="gone" />

            <TextView
                android:id="@+id/reps_title"
                style="@style/Widget.Gym.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_progress_reps_title" />

            <LinearLayout
                android:id="@+id/reps_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/more_loads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="E mais 4 cargas, fora desta lista."
                tools:visibility="visible" />

            <!--
                The window filter of PRG-02. Below the records on purpose: it scopes the list (and
                the chart of PRG-01 that comes next), and never the records above it - "your best
                in the last five sessions" is not a record.

                The buttons carry no text here. Their labels come from the window sizes in code,
                so a label can never drift from the rule it names, and each gets a spoken label:
                "5" on its own says nothing to a screen reader.
            -->
            <TextView
                style="@style/Widget.Gym.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_progress_window_label" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/window_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/window_5"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    tools:text="5" />

                <Button
                    android:id="@+id/window_10"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    tools:text="10" />

                <Button
                    android:id="@+id/window_30"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    tools:text="30" />

                <Button
                    android:id="@+id/window_all"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    android:text="@string/exercise_progress_window_all" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/Widget.Gym.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_progress_chart_title" />

            <!--
                One measure at a time (ADR-0042). Three measures on one plot would need two or
                three y scales, and the alignment between two y scales is arbitrary: the chart
                would invent a correlation that is not in the data.
            -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/measure_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/measure_load"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    android:text="@string/exercise_progress_measure_load" />

                <Button
                    android:id="@+id/measure_volume"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    android:text="@string/exercise_progress_measure_volume" />

                <Button
                    android:id="@+id/measure_reps"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_weight="1"
                    android:text="@string/exercise_progress_measure_reps" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chart_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m">

                    <!-- With one series there is no legend, so the title says what is drawn. -->
                    <TextView
                        android:id="@+id/chart_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        tools:text="Maior carga por sessão" />

                    <io.github.thiagojosetj.gym.ui.progress.SessionChartView
                        android:id="@+id/chart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s" />

                    <TextView
                        android:id="@+id/chart_reading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="21 de jul. de 2026 · 50 kg · recorde" />

                    <TextView
                        android:id="@+id/chart_halo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/exercise_progress_chart_halo"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Why there is no line, when there is no line. Never a blank space. -->
            <TextView
                android:id="@+id/chart_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Um gráfico precisa de pelo menos duas sessões."
                tools:visibility="visible" />

            <TextView
                style="@style/Widget.Gym.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_progress_sessions_title" />

            <!-- What the window left out, counted: nothing disappears in silence. -->
            <TextView
                android:id="@+id/showing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Mostrando as últimas 10 de 37 sessões."
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/session_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_xxl"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_progress"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:text="@string/exercise_progress_empty_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/exercise_progress_empty_body"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
