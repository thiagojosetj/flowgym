<?xml version="1.0" encoding="utf-8"?>
<!--
    App shell: top app bar, navigation host and bottom navigation. Edge-to-edge is always on
    (targetSdk 35+); MainActivity applies the system bar and keyboard insets explicitly.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!--
        labelVisibilityMode is explicit on purpose. The default is "auto", which Material reads as
        "label only the selected tab once there are MORE THAN THREE items"
        (NavigationBarMenuView.isShifting: mode == AUTO ? childCount > 3 : ...). Adding the fourth
        tab therefore silently took the labels off Início, Treinos and Exercícios - three screens
        this change never meant to touch, and nothing in the test suite would have noticed.
        "labeled" restores exactly the previous behaviour, and pins it so the fifth tab cannot
        repeat the trick.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
