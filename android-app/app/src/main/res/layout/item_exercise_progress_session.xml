<?xml version="1.0" encoding="utf-8"?>
<!--
    One session of one exercise (PRODUCT_SPEC PRG-03). This list is also the chart's table view:
    every value the chart draws is readable here as text, so nothing on this screen is reachable
    only by touching a drawing.

    Not clickable. The session detail is reached from the history, where the whole workout is;
    a row here is a reading of one exercise, not a door.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/session_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            tools:text="28 de set. de 2026" />

        <!--
            The word carries the meaning and the colour only reinforces it: a badge that said
            "record" in amber alone would say nothing to a person who cannot see the amber.
        -->
        <TextView
            android:id="@+id/session_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:importantForAccessibility="no"
            android:text="@string/exercise_progress_point_record"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorTertiary"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/session_counts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Séries: 3 · reps: 28 · Maior carga: 40 kg · Volume: 1.120 kg" />
</LinearLayout>
