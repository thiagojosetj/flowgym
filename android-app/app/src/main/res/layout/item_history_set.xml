<?xml version="1.0" encoding="utf-8"?>
<!--
    One set of a finished session: its number (or warm-up badge), what was DONE, what the snapshot
    PLANNED and what the paired set did last time. Read-only: a finished session cannot be edited.
    A value that was never informed is drawn as a dash by the adapter, never as a zero.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/screen_margin"
    android:paddingVertical="@dimen/space_xs">

    <TextView
        android:id="@+id/set_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/performed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="10 reps · 40 kg" />

        <TextView
            android:id="@+id/planned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Planejado: 12 reps · 40 kg"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/previous"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="Anterior: 10 reps · 37,5 kg"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
