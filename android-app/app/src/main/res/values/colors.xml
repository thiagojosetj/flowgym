<?xml version="1.0" encoding="utf-8"?>
<!--
    Brand palette, LIGHT scheme (the dark scheme lives in values-night/colors.xml with the same names,
    so a single theme definition works for both).
    Own identity: tonal palette from seed #006B5A (deep teal-green) plus an amber tertiary reserved
    for records and achievements. Text roles meet WCAG AA contrast.
-->
<resources>
    <color name="md_primary">#006B5A</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#9EF2DB</color>
    <color name="md_on_primary_container">#00201A</color>
    <color name="md_secondary">#4A635C</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#CCE8DF</color>
    <color name="md_on_secondary_container">#06201A</color>
    <color name="md_tertiary">#7C5800</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#FFDEA6</color>
    <color name="md_on_tertiary_container">#271900</color>
    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#410002</color>
    <color name="md_background">#F7FAF8</color>
    <color name="md_on_background">#191C1B</color>
    <color name="md_surface">#F7FAF8</color>
    <color name="md_on_surface">#191C1B</color>
